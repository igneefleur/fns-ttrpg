{
  "manifest_version": 3,
  "name": "Fiche JJK sur Roll20",
  "version": "1.0.8",
  "description": "Affiche vos fiches de personnage JJK (système JDR) à la place de la fiche Roll20, avec les jets envoyés dans le tchat.",
  "homepage_url": "https://igneefleur.github.io/HxH-Regles-JDR/jjk/",
  "permissions": [
    "storage"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "roll20-page.js",
        "creator.html",
        "creator.css",
        "creator-boot.js",
        "creation-embed.js",
        "jjk-creation.json",
        "attr-map.js",
        "jjk-creation.css",
        "sheet-fonts.css"
      ],
      "matches": [
        "https://app.roll20.net/*"
      ]
    }
  ],
  "icons": {
    "48": "icons/icon48.png",
    "96": "icons/icon96.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/icon48.png",
      "96": "icons/icon96.png"
    },
    "default_title": "Fiche JJK"
  },
  "content_scripts": [
    {
      "matches": [
        "https://igneefleur.github.io/HxH-Regles-JDR/*",
        "http://127.0.0.1:8000/HxH-Regles-JDR/*",
        "http://localhost:8000/HxH-Regles-JDR/*"
      ],
      "js": [
        "content-jjk.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://app.roll20.net/*"
      ],
      "js": [
        "content-roll20.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
