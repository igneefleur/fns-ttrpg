{
  "manifest_version": 2,
  "name": "Fiche MIA sur Roll20",
  "version": "1.0.0",
  "description": "Affiche vos fiches de personnage MIA (système JDR) à la place de la fiche Roll20, avec les jets envoyés dans le tchat.",
  "homepage_url": "https://igneefleur.github.io/fns-ttrpg/mia/",
  "browser_specific_settings": {
    "gecko": {
      "id": "mia-roll20@igneefleur",
      "strict_min_version": "109.0",
      "update_url": "https://igneefleur.github.io/fns-ttrpg/mia/download/updates.json"
    }
  },
  "permissions": [
    "storage"
  ],
  "web_accessible_resources": [
    "creator.html",
    "creator.css",
    "panneau.html",
    "shell-loader.js",
    "stable/roll20-page.js",
    "stable/creator-shell.js",
    "stable/panneau-shell.js",
    "beta/roll20-page.js",
    "beta/creator-shell.js",
    "beta/panneau-shell.js"
  ],
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "browser_action": {
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon.svg",
    "default_title": "Fiche MIA"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.roll20.net/*"
      ],
      "js": [
        "stable/content-roll20.js",
        "beta/content-roll20.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
